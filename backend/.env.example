# Neon Serverless PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Payment provider: "razorpay" for production/test mode, "fake" for offline local dev
PAYMENT_PROVIDER=razorpay

# Razorpay Test Mode credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Allowed frontend origin for CORS (e.g. https://your-app.pages.dev)
FRONTEND_URL=http://localhost:5500
